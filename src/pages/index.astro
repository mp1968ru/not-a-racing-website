---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
import {
  ArrowRight,
  ArrowUpRight,
  ArrowDown,
  ArrowLeft,
  Menu,
  X,
  Plus,
  Flag,
  Zap,
} from "lucide-astro";

const departments = [
  {
    number: "01",
    title: "Engineering",
    text: "Turn theory into a car that can compete. Explore aerodynamics, chassis, suspension, powertrain, electronics, and vehicle dynamics with a team that learns by building.",
  },
  {
    number: "02",
    title: "Business & operations",
    text: "Run the team behind the team. Build sponsor relationships, manage budgets, organize competition logistics, and help make an ambitious student project possible.",
  },
  {
    number: "03",
    title: "Design & media",
    text: "Tell the story of Rutgers racing. Bring your perspective to photography, video, graphic design, and the way our team connects with the world.",
  },
];
const questions = [
  {
    question: "Do I need experience to join?",
    answer:
      "No. Curiosity and a willingness to learn are what matter. Our members teach one another, and new students can contribute while developing their skills.",
  },
  {
    question: "Is RFR only for engineering students?",
    answer:
      "RFR welcomes Rutgers students across majors. Business, design, communications, and operations are as essential to the team as the engineering behind the car.",
  },
  {
    question: "How do I get involved?",
    answer:
      "Email rutgerssae@gmail.com to introduce yourself and ask about the next team meeting. Tell us your major and what interests you, and we can help you find a place to start.",
  },
];
