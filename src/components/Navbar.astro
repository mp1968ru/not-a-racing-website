---
import { ArrowUpRight, Menu, X } from "lucide-astro";

interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
const isDark = theme === "dark";
---

<header
  class:list={[
    "site-navbar sticky top-0 z-40",
    isDark
      ? "site-navbar--dark text-parchment"
      : "bg-white text-obsidian",
  ]}
>
      <div class="page-gutter flex h-[88px] items-center justify-center gap-6 max-md:h-[76px]">
        <nav
          class="hidden items-center gap-8 md:flex font-sans"
          aria-label="Main navigation"
        >
          <a href="#about" class="navigation-link">
            Our story
          </a>
          <a href="#cars" class="navigation-link">
            The car
          </a>
          <a href="#team" class="navigation-link">
            The team
          </a>
          <a href="#partners" class="navigation-link">
            Our partners
          </a>
        </nav>
        <!-- <a
          href="#join"
          class:list={[
            "hidden items-center gap-7 px-5 py-3.5 text-[12px] font-sans md:flex",
            isDark ? "bg-parchment text-obsidian" : "bg-oxblood text-white",
          ]}
        >
          Join the team <ArrowUpRight size={16} aria-hidden="true" />
        </a> -->
        <button
          id="menu-toggle"
          class="grid h-11 w-11 place-items-center md:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Menu id="menu-open-icon" size={24} />
          <X id="menu-close-icon" size={24} class="hidden" />
        </button>
      </div>
      <nav
        id="mobile-menu"
        class="mobile-menu page-gutter pb-6 md:hidden"
        aria-label="Mobile navigation"
        hidden
      >
        <a href="#about">
          Our story <ArrowUpRight size={20} />
        </a>
        <a href="#cars">
          The car <ArrowUpRight size={20} />
        </a>
        <a href="#team">
          The team <ArrowUpRight size={20} />
        </a>
        <a href="#partners">
          Our partners <ArrowUpRight size={20} />
        </a>
        <a href="#join" class:list={[!isDark && "text-oxblood"]}>
          Join the team <ArrowUpRight size={20} />
        </a>
      </nav>
    </header>

<style>
  .site-navbar--dark {
    margin-bottom: calc(-1 * var(--site-header-height));
    background-color: rgb(0 0 0 / var(--navbar-solid, 0));
    background-image: linear-gradient(to bottom, #000, transparent);
  }

  .site-navbar--dark:has([aria-expanded="true"]) {
    background-color: #000;
  }
</style>

<script>
  const navbar = document.querySelector<HTMLElement>(".site-navbar--dark");

  if (navbar) {
    const updateNavbar = () => {
      navbar.style.setProperty(
        "--navbar-solid",
        String(Math.min(Math.max(window.scrollY / 120, 0), 1)),
      );
    };

    updateNavbar();
    window.addEventListener("scroll", updateNavbar, { passive: true });
    window.addEventListener("pageshow", updateNavbar);
  }
</script>
