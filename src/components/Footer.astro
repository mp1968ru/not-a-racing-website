---
import { ArrowUpRight, Menu, X } from "lucide-astro";

interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
const isDark = theme === "dark";
---

<footer class="page-gutter bg-obsidian pb-6 pt-14 font-sans text-parchment">
      <div class="grid gap-10 pb-12 md:grid-cols-[2fr_1fr_1fr]">
        <div>
          <a href="#" class="font-display text-[35px] leading-tight">
            Rutgers
            <br />
            <span class="italic">Formula Racing.</span>
          </a>
          <p class="section-label mt-5 text-[12px] text-parchment/75">
            New Brunswick, New Jersey
            <br />
            Built with Rutgers pride, since 1989.
          </p>
        </div>
        <div>
          <p class="section-label mb-5 text-[12px] text-parchment/75">Explore</p>
          <nav class="grid gap-3 text-[14px] leading-relaxed" aria-label="Footer navigation">
            <a href="#about" class="hover:underline">
              Our story
            </a>
            <a href="#cars" class="hover:underline">
              The car
            </a>
            <a href="#team" class="hover:underline">
              The team
            </a>
            <a href="#partners" class="hover:underline">
              Our partners
            </a>
          </nav>
        </div>
        <div>
          <p class="section-label mb-5 text-[12px] text-parchment/75">Get in touch</p>
          <a
            href="mailto:rutgerssae@gmail.com"
            class="text-[14px] hover:underline"
          >
            rutgerssae@gmail.com
          </a>
          <p class="mt-4 text-[14px] leading-[1.8] text-parchment/85">
            140 Bevier Road
            <br />
            Piscataway, NJ 08854
          </p>
          <a href="#join" class="text-link mt-3">
            Join the team <ArrowUpRight aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-parchment/20 pt-6 section-label text-[12px] text-parchment/75">
        <span>© {new Date().getFullYear()} Rutgers Formula Racing</span>
        <a href="#" class="flex items-center gap-2 hover:text-parchment">
          Back to top <ArrowUpRight size={13} aria-hidden="true" />
        </a>
      </div>
    </footer>